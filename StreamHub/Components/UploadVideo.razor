@rendermode InteractiveServer
@inject IWebHostEnvironment Env
@inject IVideoMetadataService VideoMetadataService
@using StreamHub.Models.VideoMetadatas
@using StreamHub.Services.Foundations

<PageTitle>Upload Video</PageTitle>

<div class="upload-container">
    <h3>Upload Video</h3>

    <div class="form-group">
        <label>Video File:</label>
        <InputFile OnChange="HandleVideoFileSelected" MaxFileSize="1073741824" accept="video/*" class="file-input" />
    </div>

    <div class="form-group">
        <label>Video Title:</label>
        <InputText @bind-Value="videoTitle" class="text-input" />
    </div>

    <div class="form-group">
        <label>Video Description:</label>
        <InputText @bind-Value="videoDescription" class="text-input" />
    </div>

    <h3>Upload Thumbnail</h3>
    <div class="form-group">
        <label>Thumbnail File:</label>
        <InputFile OnChange="HandleThumbnailFileSelected" MaxFileSize="10485760" accept="image/png, image/jpeg" class="file-input" />
    </div>

    <button @onclick="SaveVideoToWwwRoot" class="btn" disabled="@isUploading">Upload</button>

    @if (isUploading)
    {
        <div class="uploading-message">
            <p>Please wait, uploading...</p>
            <div class="icons">
                <span class="rotating-icon">☀</span>
                <span class="rotating-icon">☾</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Message))
    {
        <p class="message">@((MarkupString)Message)</p>
    }
</div>

<style>
    .upload-container {
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
        width: 400px;
        margin: auto;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .file-input, .text-input, .btn {
        width: 100%;
        padding: 8px;
        margin-top: 4px;
        box-sizing: border-box;
    }

    .btn {
        background-color: #4CAF50;
        color: white;
        border: none;
        cursor: pointer;
        transition: background 0.3s ease;
    }

        .btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }

    .uploading-message {
        margin-top: 10px;
        color: #f39c12;
    }

    .rotating-icon {
        display: inline-block;
        margin: 0 5px;
        animation: rotate 1s linear infinite;
    }

    rotate {
        from

    {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

    }
</style>
