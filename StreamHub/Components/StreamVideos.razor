@rendermode InteractiveServer

<PageTitle>Videolar</PageTitle>

@if (videoMetadatas != null && videoMetadatas.Any())
{
    <div class="video-grid">
        <Virtualize ItemsProvider="LoadVideoMetadatas" Context="video">
            <div class="video-card" @onclick="() => SelectVideo(video.VideoUrl)">
                <img class="video-thumbnail" src="@video.Thumbnail" alt="Video Thumbnail" loading="lazy" />
                <div class="video-info">
                    <h3 class="video-title">@video.Title</h3>
                    <p class="video-description">@video.Description</p>
                </div>
            </div>
        </Virtualize>
    </div>

    @if (!string.IsNullOrEmpty(selectedVideo))
    {
        <div class="video-overlay">
            <button class="close-btn" @onclick="CloseVideo">✖</button>
            <div class="video-modal">
                <video controls preload="metadata" playsinline>
                    <source src="@selectedVideo" type="video/mp4" />
                    Your browser does not support the video tag.
                </video>
            </div>
        </div>
    }
}
else
{
    <p>Loading videos...</p>
}


<style>
    .video-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        padding: 20px;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    .video-card {
        background: #181818;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .video-card:hover {
            transform: scale(1.05);
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
        }

    .video-thumbnail {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-bottom: 1px solid #282828;
    }

    .video-info {
        padding: 12px;
        color: white;
    }

    .video-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 5px;
        color: #fff;
    }

    .video-description {
        font-size: 14px;
        color: #aaa;
    }

    .video-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .video-modal {
        width: 80%;
        max-width: 900px;
        background: black;
        padding: 10px;
        border-radius: 10px;
        box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.3);
    }

        .video-modal video {
            width: 100%;
            border-radius: 10px;
        }

    /* Close Button */
    .close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #ff4d4d;
        color: white;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background-color 0.3s ease;
    }

        .close-btn:hover {
            background-color: #ff1a1a;
        }
</style>

   
  
